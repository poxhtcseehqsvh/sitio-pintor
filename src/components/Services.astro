---
import Icon from './Icon.astro';
import { DICT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = DICT[Astro.props.lang].services;
const accents = ['red', 'green', 'navy', 'red'];
---

<section class="section" id="services">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.intro}</p>
    </header>

    <div class="services">
      {
        t.items.map((s, i) => (
          <article class={`service service--${accents[i]}`}>
            <div class="hex-icon">
              <Icon name={s.icon} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
