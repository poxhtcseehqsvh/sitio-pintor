};

const isFilled = name in filled;
---

{
  isFilled ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={filled[name]} />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={stroke[name] ?? ''}
    />
  )
}
