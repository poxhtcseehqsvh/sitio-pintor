---
import Icon from './Icon.astro';
import { SITE, GALLERY, WEB3FORMS_ACCESS_KEY, whatsappUrl } from '../config';
import { DICT, PATHS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const wa = whatsappUrl(t.whatsappMessage);
const year = new Date().getFullYear();
---

<div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={PATHS[lang]} aria-label={SITE.name}>
      <img src="/logo-mark.svg" alt="" width="44" height="44" />
      <span class="brand__text">
        <strong>Rizzo Ditalia</strong>
        <small>Painting Corp.</small>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Main">
      <a href="#services">{t.nav.services}</a>
      <a href="#why">{t.nav.why}</a>
      <a href="#gallery">{t.nav.gallery}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={SITE.phoneHref}>
        <Icon name="phone" />
        <span>{SITE.phoneDisplay}</span>
      </a>
      <a
        class="lang-switch"
        href={PATHS[other]}
        hreflang={other}
        lang={other}
        data-lang-switch={other}
        aria-label={t.nav.switchLabel}
        title={t.nav.switchLabel}
      >
        <Icon name="globe" />
        <span>{t.nav.switchShort}</span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">{t.nav.menu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
        <path d="M-50 470 C 250 380, 450 560, 760 450 S 1150 380, 1300 430 L1300 650 L-50 650Z" fill="#cc0000" opacity=".9"></path>
        <path d="M-50 520 C 300 450, 520 610, 820 510 S 1180 460, 1300 500 L1300 650 L-50 650Z" fill="#006400" opacity=".85"></path>
        <path d="M-50 570 C 320 520, 560 640, 880 570 S 1200 540, 1300 560 L1300 650 L-50 650Z" fill="#ffffff" opacity=".12"></path>
      </svg>
    </div>
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--light">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>

      <a class="hero__phone" href={SITE.phoneHref}>
        <span class="hero__phone-icon"><Icon name="phone" /></span>
        <span>
          <small>{t.hero.callLabel}</small>
          <strong>{SITE.phoneDisplay}</strong>
        </span>
      </a>

      <div class="hero__ctas">
        <a class="btn btn--red btn--lg" href="#contact">{t.hero.cta}</a>
      </div>

      <ul class="hero__badges">
        <li><Icon name="check" />{t.why.items[0].title}</li>
        <li><Icon name="check" />{t.why.items[1].title}</li>
        <li><Icon name="check" />{t.hero.license}{SITE.license}</li>
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow">{t.services.eyebrow}</p>
        <h2>{t.services.title}</h2>
      </header>
      <div class="services">
        {
          t.services.items.map((s) => (
            <article class="service">
              <div class="service__icon">
                <Icon name={s.icon} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section--navy" id="why">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow eyebrow--light">{t.why.eyebrow}</p>
        <h2>{t.why.title}</h2>
      </header>
      <div class="why">
        {
          t.why.items.map((w) => (
            <div class="why__item">
              <div class="why__icon">
                <Icon name={w.icon} />
              </div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section" id="gallery">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow">{t.gallery.eyebrow}</p>
        <h2>{t.gallery.title}</h2>
        <p class="section__note">{t.gallery.note}</p>
      </header>
      <div class="gallery">
        {
          GALLERY.map((g) => (
            <figure class="gallery__item">
              <img src={g.src} alt={t.gallery.items[g.key]} loading="lazy" width="800" height="600" />
              <figcaption>{t.gallery.items[g.key]}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--soft" id="contact">
    <div class="container contact">
      <div class="contact__info">
        <p class="eyebrow">{t.contact.eyebrow}</p>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.text}</p>
        <ul class="contact__channels">
          <li>
            <a href={SITE.phoneHref}>
              <span class="channel-icon channel-icon--red"><Icon name="phone" /></span>
              <span><small>{t.contact.callUs}</small><strong>{SITE.phoneDisplay}</strong></span>
            </a>
          </li>
          <li>
            <a href={wa} target="_blank" rel="noopener">
              <span class="channel-icon channel-icon--green">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z" /></svg>
              </span>
              <span><small>{t.contact.whatsapp}</small><strong>{SITE.phoneDisplay}</strong></span>
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`}>
              <span class="channel-icon"><Icon name="mail" /></span>
              <span><small>{t.contact.emailUs}</small><strong class="break">{SITE.email}</strong></span>
            </a>
          </li>
        </ul>
        <p class="contact__area"><Icon name="pin" />{t.contact.area}</p>
      </div>

      <form
        class="form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-form
        data-msg-sending={t.contact.sending}
        data-msg-success={t.contact.success}
        data-msg-error={t.contact.error}
        data-msg-not-configured={t.contact.notConfigured}
      >
        <!-- ⚠️ WEB3FORMS ACCESS KEY: set it in src/config.ts (WEB3FORMS_ACCESS_KEY) -->
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value={t.contact.subject} />
        <input type="hidden" name="from_name" value={`${SITE.shortName} Website`} />
        <input type="hidden" name="language" value={lang === 'en' ? 'English' : 'Español'} />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

        <div class="form__row">
          <div class="field">
            <label for="name">{t.contact.name}</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="phone">{t.contact.phone}</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>
        <div class="field">
          <label for="email">{t.contact.email}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="service">{t.contact.service}</label>
          <select id="service" name="service" required>
            <option value="" disabled selected>{t.contact.servicePlaceholder}</option>
            {t.services.items.map((s) => <option>{s.title}</option>)}
            <option>{t.contact.serviceOther}</option>
          </select>
        </div>
        <div class="field">
          <label for="message">{t.contact.message}</label>
          <textarea id="message" name="message" rows="5" placeholder={t.contact.messagePlaceholder} required></textarea>
        </div>
        <button class="btn btn--red btn--block" type="submit" data-submit>{t.hero.cta}</button>
        <p class="form__status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <a class="brand brand--light" href={PATHS[lang]}>
        <img src="/logo-mark.svg" alt="" width="44" height="44" />
        <span class="brand__text"><strong>Rizzo Ditalia</strong><small>Painting Corp.</small></span>
      </a>
      <p class="footer__tagline">{t.footer.tagline}</p>
    </div>
    <ul class="footer__contact">
      <li><Icon name="phone" /><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></li>
      <li><Icon name="mail" /><a class="break" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><Icon name="license" /><span>{t.footer.license}{SITE.license}</span></li>
      <li><Icon name="pin" /><span>Miami, Florida</span></li>
    </ul>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {SITE.name}. {t.footer.rights}</p>
    <a href={PATHS[other]} hreflang={other} lang={other} data-lang-switch={other}>{t.nav.switchLabel}</a>
  </div>
</footer>

<a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label={t.whatsappLabel}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z" /></svg>
</a>

<script>
  // Language switch: save preference
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('rdp-lang', a.dataset.langSwitch!);
      } catch {}
      a.href = a.pathname + location.hash;
    });
  });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const nav = document.getElementById('nav')!;
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Contact form (Web3Forms)
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const msg = form.dataset;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const key = form.querySelector<HTMLInputElement>('[name="access_key"]')!.value;
    if (!key || key.startsWith('YOUR_')) {
      status.className = 'form__status is-error';
      status.textContent = msg.msgNotConfigured!;
      return;
    }
    submit.disabled = true;
    status.className = 'form__status';
    status.textContent = msg.msgSending!;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);
      form.reset();
      status.className = 'form__status is-success';
      status.textContent = msg.msgSuccess!;
    } catch {
      status.className = 'form__status is-error';
      status.textContent = msg.msgError!;
    } finally {
      submit.disabled = false;
    }
  });
</script>
