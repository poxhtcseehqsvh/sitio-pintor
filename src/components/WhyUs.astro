---
import Icon from './Icon.astro';
import { SITE } from '../config';
import { DICT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = DICT[Astro.props.lang];
---

<section class="section section--soft" id="why">
  <div class="container why">
    <div class="why__intro">
      <p class="eyebrow">{t.why.eyebrow}</p>
      <h2>{t.why.title}</h2>
      <p>{t.why.text}</p>
      <a class="why__phone" href={SITE.phoneHref}>
        <Icon name="phone" />
        {SITE.phoneDisplay}
      </a>
    </div>

    <ul class="why__grid">
      {
        t.why.items.map((item) => (
          <li class="why__item">
            <span class="why__icon">
              <Icon name={item.icon} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
