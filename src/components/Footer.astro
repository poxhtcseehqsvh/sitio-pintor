---
import { SITIO, urlWhatsapp } from '../config';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor rejilla">
    <div>
      <p class="pie-nombre">{SITIO.nombre}</p>
      <p class="pie-frase">{SITIO.frase}</p>
      <p class="pie-zona">{SITIO.zona}</p>
    </div>
    <nav aria-label="Pie de página">
      <ul>
        <li><a href="/galeria/">Trabajos</a></li>
        <li><a href="/sobre-mi/">Sobre mí</a></li>
        <li><a href="/contacto/">Cotización</a></li>
      </ul>
    </nav>
    <ul class="pie-contacto">
      <li><a href={urlWhatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
      <li><a href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a></li>
      {SITIO.facebook && <li><a href={SITIO.facebook} target="_blank" rel="noopener">Facebook</a></li>}
    </ul>
  </div>
  <div class="contenedor legal">
    <p>© {anio} {SITIO.nombre} · {SITIO.oficio}</p>
  </div>
</footer>

<style>
  .pie {
    margin-top: clamp(4rem, 10vw, 7rem);
    background: var(--hueso);
    border-top: 1px solid var(--linea);
    font-size: 0.9375rem;
  }
  .rejilla {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 4rem 3rem;
  }
  .pie-nombre {
    font-family: var(--serif);
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .pie-frase {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--tinta-suave);
    max-width: 24rem;
  }
  .pie-zona {
    font-size: 0.875rem;
    color: var(--tinta-suave);
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  a {
    text-decoration: none;
    color: var(--tinta-suave);
    transition: color 0.3s;
    overflow-wrap: anywhere;
  }
  a:hover {
    color: var(--acento);
  }
  .legal {
    border-top: 1px solid var(--linea);
    padding-block: 1.5rem;
    font-size: 0.8125rem;
    color: var(--tinta-suave);
  }
  .legal p {
    margin: 0;
  }
  @media (max-width: 720px) {
    .rejilla {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
