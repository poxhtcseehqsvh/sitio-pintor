---
import Layout from '../layouts/Layout.astro';
import { DICT } from '../i18n';
const en = DICT.en.notFound;
const es = DICT.es.notFound;
---

<Layout lang="en" title="404 | Rizzo Ditalia Painting" description={en.text} noindex>
  <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>
  <main class="not-found container">
    <img src="/logo-mark.svg" alt="" width="72" height="72" />
    <h1>404</h1>
    <h2>{en.title}</h2>
    <p>{en.text}</p>
    <a class="btn btn--red" href="/">{en.back}</a>
    <hr />
    <h2 lang="es">{es.title}</h2>
    <p lang="es">{es.text}</p>
    <a class="btn btn--navy" href="/es/" lang="es">{es.back}</a>
  </main>
</Layout>
