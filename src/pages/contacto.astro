---
import Layout from '../layouts/Layout.astro';
import { SITIO, SERVICIOS, urlWhatsapp } from '../config';
---

<Layout
  titulo="Contacto"
  descripcion={`Pida una cotización de pintura a ${SITIO.nombre}: casas, fachadas, oficinas y locales comerciales.`}
>
  <div class="contenedor">
    <header class="encabezado-pagina" data-reveal>
      <p class="etiqueta">Contacto</p>
      <h1>Pida su cotización</h1>
      <p>
        Cuénteme qué necesita pintar y le respondo con un presupuesto sin compromiso. Si lo prefiere, escríbame
        directamente por WhatsApp.
      </p>
    </header>

    <div class="contacto">
      <form class="formulario" action="https://api.web3forms.com/submit" method="POST" data-formulario data-reveal>
        <!-- ⚠️ La access key de Web3Forms se configura en src/config.ts -->
        <input type="hidden" name="access_key" value={SITIO.web3formsAccessKey} />
        <input type="hidden" name="subject" value={`Nueva solicitud de cotización desde el sitio web`} />
        <input type="hidden" name="from_name" value={`Sitio web de ${SITIO.nombre}`} />
        <!-- Protección anti-spam: los humanos no ven este campo -->
        <input type="checkbox" name="botcheck" class="solo-lectores" tabindex="-1" autocomplete="off" />

        <div class="campo">
          <label for="nombre">Nombre</label>
          <input id="nombre" name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="campo">
          <label for="telefono">Teléfono / WhatsApp</label>
          <input id="telefono" name="telefono" type="tel" autocomplete="tel" required />
        </div>
        <div class="campo">
          <label for="servicio">Tipo de trabajo</label>
          <select id="servicio" name="servicio">
            {SERVICIOS.map((s) => <option>{s.titulo}</option>)}
            <option>Otro</option>
          </select>
        </div>
        <div class="campo">
          <label for="ubicacion">Colonia o zona <span class="opcional">(opcional)</span></label>
          <input id="ubicacion" name="ubicacion" type="text" autocomplete="address-level3" />
        </div>
        <div class="campo">
          <label for="mensaje">¿Qué necesita pintar?</label>
          <textarea id="mensaje" name="mensaje" rows="5" required data-mensaje placeholder="Ej.: sala y comedor, unos 40 m², cambio de color…"></textarea>
        </div>

        <button class="boton boton--acento" type="submit" data-enviar>Enviar solicitud</button>
        <p class="estado" role="status" aria-live="polite" data-estado></p>
      </form>

      <aside class="directo" data-reveal style="--retraso:0.15s">
        <h2>Contacto directo</h2>
        <ul>
          <li>
            <a class="canal" href={urlWhatsapp} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"
                ></path>
              </svg>
              <span>
                <strong>WhatsApp</strong>
                <small>Escríbame directamente</small>
              </span>
            </a>
          </li>
          <li>
            <a class="canal" href={`mailto:${SITIO.correo}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M3 5h18v14H3z M3 6l9 7 9-7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"></path>
              </svg>
              <span>
                <strong>Correo</strong>
                <small>{SITIO.correo}</small>
              </span>
            </a>
          </li>
        </ul>
        <p class="frase">«{SITIO.frase}»</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const estado = form.querySelector<HTMLElement>('[data-estado]')!;
  const boton = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
  const mensaje = form.querySelector<HTMLTextAreaElement>('[data-mensaje]')!;

  // Si se llega desde la galería ("Quiero algo así"), prellenar el mensaje
  const referencia = new URLSearchParams(location.search).get('trabajo');
  if (referencia && !mensaje.value) {
    mensaje.value = `Hola, vi el trabajo «${referencia}» y me gustaría algo parecido.`;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.querySelector<HTMLInputElement>('[name="access_key"]')!.value.startsWith('TU_ACCESS_KEY')) {
      estado.className = 'estado error';
      estado.textContent = 'El formulario aún no está configurado (falta la access key de Web3Forms).';
      return;
    }
    boton.disabled = true;
    estado.className = 'estado';
    estado.textContent = 'Enviando…';
    try {
      const datos = Object.fromEntries(new FormData(form));
      const r = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(datos),
      });
      const json = await r.json();
      if (!r.ok || !json.success) throw new Error(json.message);
      form.reset();
      estado.className = 'estado exito';
      estado.textContent = '¡Gracias! Recibí su solicitud y le responderé pronto.';
    } catch {
      estado.className = 'estado error';
      estado.textContent = 'No se pudo enviar el mensaje. Inténtelo de nuevo o escríbame por WhatsApp o correo.';
    } finally {
      boton.disabled = false;
    }
  });
</script>

<style>
  .contacto {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .campo {
    margin-bottom: 1.75rem;
  }
  label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .opcional {
    font-weight: 300;
    letter-spacing: 0.05em;
    text-transform: none;
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #cdbfa9;
    border-radius: 0;
    font: inherit;
    font-size: 1.0625rem;
    color: var(--tinta);
    transition: border-color 0.3s;
  }
  select {
    cursor: pointer;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--acento);
    box-shadow: 0 1px 0 0 var(--acento);
  }
  button[disabled] {
    opacity: 0.6;
    cursor: wait;
  }
  .estado {
    margin-top: 1.25rem;
    min-height: 1.7em;
    font-size: 0.9375rem;
  }
  .estado.exito {
    color: #4d6b3c;
  }
  .estado.error {
    color: #a33a2a;
  }

  .directo {
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--hueso);
  }
  .directo h2 {
    font-size: 1.9rem;
    margin-bottom: 1.5rem;
  }
  .directo ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .canal {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--papel);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease);
  }
  .canal:hover {
    border-color: var(--acento);
    transform: translateX(4px);
  }
  .canal svg {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
    color: var(--acento);
  }
  .canal span {
    display: grid;
    min-width: 0;
  }
  .canal strong {
    font-weight: 500;
  }
  .canal small {
    font-size: 0.875rem;
    color: var(--tinta-suave);
    overflow-wrap: anywhere;
  }
  .frase {
    margin: 2rem 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--tinta-suave);
  }

  @media (max-width: 860px) {
    .contacto {
      grid-template-columns: 1fr;
    }
  }
</style>
