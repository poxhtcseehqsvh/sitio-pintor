---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TrabajoCard from '../components/TrabajoCard.astro';
import { SITIO, SERVICIOS, urlWhatsapp } from '../config';
import { trabajosOrdenados } from '../lib/trabajos';

const trabajos = await trabajosOrdenados();
const portada = trabajos.find((t) => t.data.portada) ?? trabajos[0];
const seleccion = trabajos.filter((t) => t.data.destacado && t.id !== portada?.id).slice(0, 6);
// Si hay pocos destacados, completa con los demás hasta 3 como mínimo
if (seleccion.length < 3) {
  seleccion.push(
    ...trabajos.filter((t) => t.id !== portada?.id && !seleccion.includes(t)).slice(0, 3 - seleccion.length),
  );
}

// ✏️ Puntos de confianza (texto de ejemplo, edítalo)
const razones = [
  { numero: `${SITIO.experiencia}+`, texto: 'años de experiencia' },
  { numero: '100%', texto: 'limpieza al terminar' },
  { numero: 'Gratis', texto: 'visita y cotización' },
];
---

<Layout>
  <section class="hero contenedor">
    <div class="hero-texto">
      <p class="etiqueta hero-anim" style="--d:0.1s">{SITIO.oficio}</p>
      <h1 class="hero-anim" style="--d:0.2s">{SITIO.nombre}</h1>
      <p class="hero-frase hero-anim" style="--d:0.35s">{SITIO.frase}</p>
      <div class="hero-acciones hero-anim" style="--d:0.5s">
        <a class="boton boton--acento" href="/contacto/">Pedir cotización</a>
        <a class="enlace-flecha" href="/galeria/">Ver trabajos <span aria-hidden="true">→</span></a>
      </div>
    </div>

    {
      portada && (
        <figure class="hero-foto">
          <a href={`/galeria/#${portada.id}`} class="hero-marco" aria-label={`Ver «${portada.data.titulo}» en la galería`}>
            <Image
              src={portada.data.imagen}
              alt={`${portada.data.titulo}: ${portada.data.trabajo}`}
              widths={[600, 900, 1300, 1600]}
              sizes="(max-width: 900px) 92vw, 58vw"
              loading="eager"
              fetchpriority="high"
              quality={82}
            />
          </a>
          <figcaption>
            <em>{portada.data.titulo}</em>
            {portada.data.ubicacion && ` — ${portada.data.ubicacion}`}
          </figcaption>
        </figure>
      )
    }
  </section>

  <section class="seccion servicios">
    <div class="contenedor">
      <div class="cabecera-seccion" data-reveal>
        <div>
          <p class="etiqueta">Servicios</p>
          <h2>Pintura para casas y negocios</h2>
        </div>
        <p class="cabecera-texto">
          Desde un cuarto hasta una fachada completa. Cada trabajo incluye protección de muebles y pisos, preparación de
          la superficie y limpieza final.
        </p>
      </div>
      <ol class="rejilla-servicios">
        {
          SERVICIOS.map((s, i) => (
            <li data-reveal style={`--retraso:${(i % 3) * 0.1}s`}>
              <span class="numero">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="seccion trabajos">
    <div class="contenedor">
      <div class="cabecera-seccion" data-reveal>
        <div>
          <p class="etiqueta">Trabajos recientes</p>
          <h2>Algunos proyectos</h2>
        </div>
        <a class="enlace-flecha" href="/galeria/">Ver todos los trabajos <span aria-hidden="true">→</span></a>
      </div>

      <div class="rejilla-trabajos">
        {seleccion.map((t, i) => <TrabajoCard trabajo={t} href={`/galeria/#${t.id}`} indice={i} />)}
      </div>
    </div>
  </section>

  <section class="seccion confianza">
    <div class="contenedor">
      <ul class="cifras">
        {
          razones.map((r, i) => (
            <li data-reveal style={`--retraso:${i * 0.12}s`}>
              <span class="cifra">{r.numero}</span>
              <span>{r.texto}</span>
            </li>
          ))
        }
      </ul>
      <blockquote data-reveal>
        <p>
          «Me gusta que cada cliente quede contento con el resultado. Llego puntual, cuido su casa como si fuera la mía y
          no me voy hasta que todo queda limpio.»
        </p>
        <cite>— {SITIO.nombre}</cite>
      </blockquote>
    </div>
  </section>

  <section class="contenedor llamada" data-reveal>
    <p class="etiqueta">Cotización sin compromiso</p>
    <h2>¿Va a pintar su casa o su negocio?</h2>
    <p>Cuénteme qué necesita y le doy un presupuesto claro, sin sorpresas.</p>
    <div class="llamada-acciones">
      <a class="boton boton--acento" href="/contacto/">Pedir cotización</a>
      <a class="boton" href={urlWhatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    min-height: calc(100svh - 5rem);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .hero h1 {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    margin-bottom: 0.3em;
  }
  .hero-frase {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.4;
    color: var(--tinta-suave);
    max-width: 26rem;
    margin-bottom: 2.5rem;
  }
  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .hero-foto {
    margin: 0;
  }
  .hero-marco {
    display: block;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(38, 34, 30, 0.45);
  }
  .hero-marco :global(img) {
    width: 100%;
    animation: aparecer-imagen 1.6s var(--ease) both;
    transition: transform 1.2s var(--ease);
  }
  .hero-marco:hover :global(img) {
    transform: scale(1.025);
  }
  .hero-foto figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--tinta-suave);
    text-align: right;
  }
  .hero-foto em {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--tinta);
  }
  .hero-anim {
    animation: subir 1.1s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes aparecer-imagen {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  .cabecera-seccion {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cabecera-seccion h2 {
    margin: 0;
  }
  .cabecera-texto {
    max-width: 30rem;
    margin: 0;
    color: var(--tinta-suave);
  }

  .servicios {
    background: var(--papel);
    border-block: 1px solid var(--linea);
  }
  .rejilla-servicios {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--linea);
    border-left: 1px solid var(--linea);
  }
  .rejilla-servicios li {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-right: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    transition: background 0.5s var(--ease);
  }
  .rejilla-servicios li:hover {
    background: var(--crema);
  }
  .numero {
    display: block;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--acento);
    margin-bottom: 1.25rem;
  }
  .rejilla-servicios h3 {
    margin-bottom: 0.6rem;
  }
  .rejilla-servicios p {
    margin: 0;
    font-size: 0.975rem;
    color: var(--tinta-suave);
  }

  .rejilla-trabajos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
  }

  .confianza {
    background: var(--tinta);
    color: var(--papel);
  }
  .cifras {
    list-style: none;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .cifras li {
    display: grid;
    gap: 0.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(251, 249, 245, 0.65);
  }
  .cifra {
    font-family: var(--serif);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    color: #e3a184;
  }
  blockquote {
    max-width: 50rem;
    margin: 0 auto;
    text-align: center;
  }
  blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    line-height: 1.4;
  }
  cite {
    font-style: normal;
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e3a184;
  }

  .llamada {
    text-align: center;
    max-width: 46rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .llamada p:not(.etiqueta) {
    color: var(--tinta-suave);
    margin-bottom: 2rem;
  }
  .llamada-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .rejilla-servicios,
    .rejilla-trabajos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .rejilla-servicios,
    .rejilla-trabajos,
    .cifras {
      grid-template-columns: 1fr;
    }
  }
</style>
