---
import '../styles/global.css';
import { SITE } from '../config';
import { DICT, PATHS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = DICT[lang];
const title = Astro.props.title ?? t.seo.title;
const description = Astro.props.description ?? t.seo.description;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(PATHS[lang], site).href;
const altEn = new URL(PATHS.en, site).href;
const altEs = new URL(PATHS.es, site).href;
const ogImage = new URL('/og-image.svg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  name: SITE.name,
  url: canonical,
  telephone: '+1-786-797-4177',
  email: SITE.email,
  image: ogImage,
  description,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: 'US',
  },
  areaServed: { '@type': 'City', name: 'Miami' },
  knowsLanguage: ['en', 'es'],
  identifier: { '@type': 'PropertyValue', name: 'License', value: SITE.license },
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1a2b5e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={altEn} />
          <link rel="alternate" hreflang="es" href={altEs} />
          <link rel="alternate" hreflang="x-default" href={altEn} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Language preference: honor the saved choice (localStorage) before the page paints */}
    <script is:inline define:vars={{ lang, paths: PATHS, noindex }}>
      if (!noindex) {
        try {
          var saved = localStorage.getItem('rdp-lang');
          var wanted = saved;
          if (!saved && lang === 'en' && /^es\b/i.test(navigator.language || '')) wanted = 'es';
          if (wanted && wanted !== lang && paths[wanted]) {
            location.replace(paths[wanted] + location.hash);
          }
        } catch (e) {}
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
