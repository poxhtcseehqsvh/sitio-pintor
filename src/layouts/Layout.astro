---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITIO } from '../config';
import { trabajosOrdenados } from '../lib/trabajos';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: ImageMetadata;
}

const { titulo, descripcion = SITIO.descripcion, imagen } = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} · ${SITIO.nombre}, ${SITIO.oficio.toLowerCase()}`
  : `${SITIO.nombre} · ${SITIO.oficio}`;

// Imagen para compartir en redes (Open Graph): la indicada o la foto de portada
let imagenOg = imagen;
if (!imagenOg) {
  const trabajos = await trabajosOrdenados();
  imagenOg = (trabajos.find((t) => t.data.portada) ?? trabajos[0])?.data.imagen;
}
const og = imagenOg ? await getImage({ src: imagenOg, width: 1200, format: 'jpg', quality: 80 }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site ?? Astro.url).href : undefined;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#f7f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={`${SITIO.nombre} · ${SITIO.oficio}`} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {og && <meta property="og:image:width" content={String(og.attributes.width)} />}
    {og && <meta property="og:image:height" content={String(og.attributes.height)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Revela elementos con [data-reveal] al entrar en pantalla
      const elementos = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        elementos.forEach((el) => el.classList.add('visible'));
      } else {
        const obs = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        elementos.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--tinta);
    color: var(--papel);
    text-decoration: none;
  }
  .saltar:focus {
    top: 1rem;
  }
</style>
